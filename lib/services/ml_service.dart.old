import 'dart:io';
import 'dart:math';
import 'package:flutter/foundation.dart';
import 'package:image/image.dart' as img;
import 'dart:convert';

class MLService {
  final OnnxTumorDetectionService _onnxService = OnnxTumorDetectionService();
  final YoloDetectionService _yoloService = YoloDetectionService();
  final DoctrService _doctrService = DoctrService();
  final DenseNetClassificationService _denseNetService =
      DenseNetClassificationService();
  final CAD3DAnalysisService _cad3dService = CAD3DAnalysisService();

  /// Flag to control which 2D detection engine to use
  bool useOnnx = true;

  Future<void> initialize() async {
    // Initialize each service independently so one failure doesn't block others
    try {
      await _onnxService.initialize();
      debugPrint('[MLService] OnnxTumorDetection initialized');
    } catch (e) {
      debugPrint('[MLService] OnnxTumorDetection init failed (non-fatal): $e');
    }

    try {
      await _denseNetService.initialize();
      debugPrint('[MLService] DenseNet initialized');
    } catch (e) {
      debugPrint('[MLService] DenseNet init failed (non-fatal): $e');
    }

    try {
      await _cad3dService.initialize();
      debugPrint('[MLService] CAD3D initialized');
    } catch (e) {
      debugPrint('[MLService] CAD3D init failed (non-fatal): $e');
    }

    debugPrint('[MLService] ML services initialization complete');
  }

  /// ONNX-Based Tumor Detection: Detect anomalies in chest X-ray
  /// Returns detection objects with high accuracy and confidence scores
  /// Falls back to YOLO if ONNX is unavailable
  Future<YoloDetectionResult> detectAnomalies({
    required dynamic imageFile, // File on mobile, Uint8List on web
    required int imageWidth,
    required int imageHeight,
  }) async {
    try {
      if (useOnnx) {
        final onnxResult = await _onnxService.detectTumors(
          imageFile: imageFile,
          imageWidth: imageWidth,
          imageHeight: imageHeight,
        );

        // Convert ONNX result to YoloDetectionResult for compatibility
        if (onnxResult.isSuccess) {
          final yoloDetections = onnxResult.detections.map((det) {
            return YoloDetection(
              x: det.x,
              y: det.y,
              width: det.width,
              height: det.height,
              className: det.className,
              confidence: det.confidence,
              classScores: det.classScores,
            );
          }).toList();

          return YoloDetectionResult(
            detections: yoloDetections,
            anomalySeverity: onnxResult.anomalySeverity,
            anomalyScore: onnxResult.anomalyScore,
            primaryAnomaly: onnxResult.primaryAnomaly,
            frameWidth: onnxResult.frameWidth,
            frameHeight: onnxResult.frameHeight,
            processingTimeMs: onnxResult.processingTimeMs,
          );
        } else {
          debugPrint('[MLService] ONNX detection failed: ${onnxResult.errorMessage}');
          debugPrint('[MLService] Falling back to YOLO detection');
          return await _yoloService.detectObjects(
            imageFile: imageFile,
            imageWidth: imageWidth,
            imageHeight: imageHeight,
          );
        }
      } else {
        return await _yoloService.detectObjects(
          imageFile: imageFile,
          imageWidth: imageWidth,
          imageHeight: imageHeight,
        );
      }
    } catch (e) {
      debugPrint('[MLService] Detection error: $e');
      return YoloDetectionResult.error('Detection failed: $e');
    }
  }

  /// DenseNet Classification: Classify chest disease
  /// Returns disease classification with confidence scores
  Future<ClassificationResult> classifyDiseaseFromXray({
    required dynamic imageFile, // File on mobile, Uint8List on web
    required int imageWidth,
    required int imageHeight,
  }) async {
    try {
      return await _denseNetService.classifyChestXray(
        imageFile: imageFile,
        imageWidth: imageWidth,
        imageHeight: imageHeight,
      );
    } catch (e) {
      debugPrint('[MLService] Classification error: $e');
      return ClassificationResult.error('Classification failed: $e');
    }
  }

  /// Doctr: Extract and recognize text from document
  /// Useful for analyzing reports, prescriptions, notes
  Future<DocumentText> recognizeDocument({
    required dynamic imageFile, // File on mobile, Uint8List on web
  }) async {
    try {
      return await _doctrService.recognizeDocument(imageFile: imageFile);
    } catch (e) {
      debugPrint('[MLService] Document recognition error: $e');
      return DocumentText(
        fullText: '',
        blocks: [],
        confidence: 0.0,
        charactersCount: 0,
        keywordsDetected: [],
      );
    }
  }

  /// COMPREHENSIVE END-TO-END ANALYSIS
  /// Runs YOLO detection + DenseNet classification + Optional OCR
  /// Returns complete analysis result for both lung detection and chest disease classification
  Future<ComprehensiveAnalysisResult> analyzeChestXrayComprehensive({
    required dynamic imageFile, // File on mobile, Uint8List on web
    required int imageWidth,
    required int imageHeight,
    String imageUrl = '', // Optional: for backend API analysis
    bool includeDocumentOCR = false,
    bool useBackendAPI = false,
  }) async {
    try {
      debugPrint('[MLService] Starting comprehensive chest X-ray analysis...');
      final startTime = DateTime.now();

      // Run classification first (reliable), detection separately (may fail)
      final classificationResult = await classifyDiseaseFromXray(
        imageFile: imageFile,
        imageWidth: imageWidth,
        imageHeight: imageHeight,
      );

      // Detection is best-effort
      YoloDetectionResult yoloResult;
      try {
        yoloResult = await detectAnomalies(
          imageFile: imageFile,
          imageWidth: imageWidth,
          imageHeight: imageHeight,
        );
      } catch (_) {
        yoloResult = YoloDetectionResult(
          detections: [],
          anomalySeverity: 'normal',
          anomalyScore: 0.0,
          primaryAnomaly: 'none',
          frameWidth: imageWidth,
          frameHeight: imageHeight,
          processingTimeMs: 0,
        );
      }

      // Run OCR if requested
      DocumentText? ocrResult;
      if (includeDocumentOCR) {
        ocrResult = await recognizeDocument(imageFile: imageFile);
      }

      // Optionally use backend API for additional analysis
      MLResponse? backendResult;
      if (useBackendAPI) {
        backendResult = await analyze(
          file: imageFile,
          imageUrl: imageUrl,
          requestHeatmap: false,
        );
      }

      final totalTime = DateTime.now().difference(startTime).inMilliseconds;

      final result = ComprehensiveAnalysisResult(
        yoloDetection: yoloResult,
        denseNetClassification: classificationResult,
        documentOCR: ocrResult,
        backendAnalysis: backendResult,
        timestamp: DateTime.now(),
        totalProcessingTimeMs: totalTime,
      );

      debugPrint('[MLService] Comprehensive analysis completed in ${totalTime}ms');
      return result;
    } catch (e) {
      debugPrint('[MLService] Comprehensive analysis error: $e');
      return ComprehensiveAnalysisResult.error('Analysis failed: $e');
    }
  }

  /// Extract metadata from recognized document
  Map<String, String> getDocumentMetadata(DocumentText document) {
    return _doctrService.extractDocumentMetadata(document);
  }

  /// Check document quality
  double getDocumentQuality(DocumentText document) {
    return _doctrService.getDocumentQualityScore(document);
  }

  /// Combined analysis: Run both YOLO detection and OCR
  /// Returns comprehensive analysis of chest X-ray with document data
  Future<CombinedAnalysisResult> analyzeChestXray({
    required dynamic imageFile, // File on mobile, Uint8List on web
    required String imageUrl, // Already-uploaded Storage URL
    required int imageWidth,
    required int imageHeight,
    bool includeDocumentOCR = true,
    bool useBackendAPI = false,
  }) async {
    try {
      // Run YOLO detection (best-effort)
      YoloDetectionResult yoloResult;
      try {
        yoloResult = await detectAnomalies(
          imageFile: imageFile,
          imageWidth: imageWidth,
          imageHeight: imageHeight,
        );
      } catch (_) {
        yoloResult = YoloDetectionResult(
          detections: [],
          anomalySeverity: 'normal',
          anomalyScore: 0.0,
          primaryAnomaly: 'none',
          frameWidth: imageWidth,
          frameHeight: imageHeight,
          processingTimeMs: 0,
        );
      }

      // Run OCR if requested
      DocumentText? ocrResult;
      if (includeDocumentOCR) {
        ocrResult = await recognizeDocument(imageFile: imageFile);
      }

      // Optionally use backend API for additional analysis
      MLResponse? backendResult;
      if (useBackendAPI) {
        backendResult = await analyze(
          file: imageFile,
          imageUrl: imageUrl,
          requestHeatmap: false,
        );
      }

      return CombinedAnalysisResult(
        yoloDetection: yoloResult,
        documentOCR: ocrResult,
        backendAnalysis: backendResult,
        timestamp: DateTime.now(),
      );
    } catch (e) {
      debugPrint('Combined analysis error: $e');
      return CombinedAnalysisResult.error('Analysis failed: $e');
    }
  }

  /// Submit a chest X-ray for analysis using trained 3D ONNX models.
  /// Converts 2D image → pseudo-3D volume → 3D U-Net + ResNet pipeline.
  /// Falls back to DenseNet 2D classification if 3D pipeline fails.
  Future<MLResponse> analyze({
    required dynamic file, // File on mobile, Uint8List on web
    String imageUrl = '',
    bool requestHeatmap = false,
  }) async {
    try {
      debugPrint('[MLService] Running analysis (3D pipeline)...');

      Uint8List imageBytes;
      if (kIsWeb) {
        imageBytes = file as Uint8List;
      } else {
        imageBytes = await (file as File).readAsBytes();
      }

      final image = img.decodeImage(imageBytes);
      if (image == null) {
        return MLResponse.error('Failed to decode image');
      }

      // Try 3D trained pipeline first
      if (!kIsWeb) {
        try {
          if (!_cad3dService.isInitialized) {
            await _cad3dService.initialize();
          }

          final cadResult = await _cad3dService.analyzeFrom2DImage(imageBytes);

          if (cadResult.isSuccess) {
            final hasNodules = cadResult.nodules.isNotEmpty;
            final diagnosis = hasNodules
                ? cadResult.overallRisk == 'High'
                    ? 'Malignant Nodule Detected'
                    : cadResult.overallRisk == 'Medium'
                        ? 'Suspicious Nodule'
                        : 'Benign Nodule'
                : 'Normal';

            final confidence = hasNodules
                ? cadResult.averageMalignancyRisk
                : 1.0 - cadResult.averageMalignancyRisk;

            debugPrint('[MLService] 3D pipeline: $diagnosis ($confidence)');

            return MLResponse(
              diagnosis: diagnosis,
              confidence: confidence,
              classScores: {
                'Normal': hasNodules ? 1 - confidence : confidence,
                'Malignant': hasNodules ? confidence : 1 - confidence,
              },
              heatmapUrl: null,
              status: AnalysisStatus.complete,
            );
          }
        } catch (e) {
          debugPrint('[MLService] 3D pipeline failed, falling back: $e');
        }
      }

      // Fallback: DenseNet 2D classification
      final classificationResult = await classifyDiseaseFromXray(
        imageFile: file,
        imageWidth: image.width,
        imageHeight: image.height,
      );

      if (!classificationResult.isSuccess) {
        return MLResponse.error('Local analysis failed');
      }

      final primary = classificationResult.primaryClassification;

      return MLResponse(
        diagnosis: primary.disease,
        confidence: primary.confidence,
        classScores: primary.classScores,
        heatmapUrl: null,
        status: AnalysisStatus.complete,
      );
    } catch (e) {
      debugPrint('[MLService] Analysis error: $e');
      return MLResponse.error('Local analysis failed: $e');
    }
  }

  /// Get annotated detections for visual overlay on doctor's screen
  /// Uses TRAINED 3D MODELS via pseudo-volume approach:
  ///   1. Convert 2D image → pseudo-3D volume (64×64×64)
  ///   2. Run trained 3D U-Net for nodule detection
  ///   3. Crop 32³ around each centroid → 3D ResNet classification
  ///   4. Map detections back to 2D bounding boxes for overlay
  /// Falls back to DenseNet classification if 3D pipeline fails.
  Future<AnnotatedAnalysisResult> getAnnotatedAnalysis({
    required dynamic file, // File on mobile, Uint8List on web
  }) async {
    try {
      debugPrint('[MLService] Generating annotated analysis (3D pipeline)...');

      // Web platform not supported for real inference
      if (kIsWeb) {
        return AnnotatedAnalysisResult.error(
          'ML analysis requires a native platform (Android/iOS)',
          0,
          0,
        );
      }

      // Validate input
      if (file == null) {
        return AnnotatedAnalysisResult.error('No image provided', 0, 0);
      }

      if (file is File && !file.existsSync()) {
        return AnnotatedAnalysisResult.error('Image file not found', 0, 0);
      }

      // Read image bytes
      Uint8List imageBytes;
      imageBytes = await (file as File).readAsBytes();

      final fullImage = img.decodeImage(imageBytes);
      if (fullImage == null) {
        return AnnotatedAnalysisResult.error('Failed to decode image', 0, 0);
      }

      final imgW = fullImage.width.toDouble();
      final imgH = fullImage.height.toDouble();

      // ─── Run trained 3D pipeline ─────────────────────────────────────
      debugPrint('[MLService] Running 2D→3D pseudo-volume through trained models...');

      if (!_cad3dService.isInitialized) {
        await _cad3dService.initialize();
      }

      final cadResult = await _cad3dService.analyzeFrom2DImage(imageBytes);

      if (cadResult.isSuccess) {
        final hasNodules = cadResult.nodules.isNotEmpty;
        final diagnosis = hasNodules
            ? cadResult.overallRisk == 'High'
                ? 'Malignant Nodule Detected'
                : cadResult.overallRisk == 'Medium'
                    ? 'Suspicious Nodule'
                    : 'Benign Nodule'
            : 'Normal';

        final confidence = hasNodules
            ? cadResult.averageMalignancyRisk
            : 1.0 - cadResult.averageMalignancyRisk;

        // Map 3D detections to 2D bounding boxes
        final annotatedDetections = <AnnotatedDetection>[];

        if (hasNodules) {
          // Place detection boxes proportional to nodule positions
          for (int i = 0; i < cadResult.nodules.length; i++) {
            final nodule = cadResult.nodules[i];
            // Spread detected nodules across the chest area
            final fraction = cadResult.nodules.length > 1
                ? i / (cadResult.nodules.length - 1)
                : 0.5;
            final centerX = imgW * (0.3 + 0.4 * fraction);
            final centerY = imgH * 0.5;
            final boxW = imgW * 0.28;
            final boxH = imgH * 0.28;

            final noduleDiag = nodule.classification ==
                    NoduleClassification.malignant
                ? 'Malignant Nodule'
                : 'Benign Nodule';

            annotatedDetections.add(AnnotatedDetection(
              x1: centerX - boxW / 2,
              y1: centerY - boxH / 2,
              x2: centerX + boxW / 2,
              y2: centerY + boxH / 2,
              diagnosis: noduleDiag,
              confidence: nodule.malignantProbability,
              yoloConfidence: nodule.confidence,
            ));
          }
        }

        // Generate heatmap
        String heatmapBase64 = '';
        if (annotatedDetections.isNotEmpty) {
          final yoloForHeatmap = YoloDetectionResult(
            detections: annotatedDetections.map((det) => YoloDetection(
              x: det.centerX,
              y: det.centerY,
              width: det.width,
              height: det.height,
              className: det.diagnosis,
              confidence: det.confidence,
              classScores: [det.confidence],
            )).toList(),
            anomalySeverity: cadResult.overallRisk.toLowerCase(),
            anomalyScore: cadResult.averageMalignancyRisk,
            primaryAnomaly: diagnosis,
            frameWidth: fullImage.width,
            frameHeight: fullImage.height,
            processingTimeMs: cadResult.totalProcessingTimeMs,
          );
          heatmapBase64 = _generateYoloHeatmap(fullImage, yoloForHeatmap);
        }

        debugPrint('[MLService] 3D pipeline result: $diagnosis '
            '(confidence: ${confidence.toStringAsFixed(3)}, '
            'nodules: ${cadResult.totalNodulesDetected}, '
            'risk: ${cadResult.overallRisk})');

        return AnnotatedAnalysisResult(
          annotatedDetections: annotatedDetections,
          overallDiagnosis: diagnosis,
          overallConfidence: confidence,
          success: true,
          imageWidth: fullImage.width,
          imageHeight: fullImage.height,
          heatmapBase64: heatmapBase64,
        );
      }

      // ─── Fallback: DenseNet 2D classification ────────────────────────
      debugPrint('[MLService] 3D pipeline failed, falling back to 2D DenseNet');

      final classResult = await classifyDiseaseFromXray(
        imageFile: file,
        imageWidth: fullImage.width,
        imageHeight: fullImage.height,
      );

      if (!classResult.isSuccess) {
        return AnnotatedAnalysisResult.error(
          'Analysis failed', fullImage.width, fullImage.height);
      }

      final fallbackDiag = classResult.primaryClassification.disease;
      final fallbackConf = classResult.primaryClassification.confidence;
      final isNormal = fallbackDiag.toLowerCase().contains('normal');

      final annotatedDetections = <AnnotatedDetection>[];
      if (!isNormal && fallbackConf > 0.15) {
        final centerX = imgW / 2;
        final centerY = imgH / 2;
        final boxW = imgW * 0.35;
        final boxH = imgH * 0.35;
        annotatedDetections.add(AnnotatedDetection(
          x1: centerX - boxW / 2,
          y1: centerY - boxH / 2,
          x2: centerX + boxW / 2,
          y2: centerY + boxH / 2,
          diagnosis: fallbackDiag,
          confidence: fallbackConf,
          yoloConfidence: fallbackConf * 0.8,
        ));
      }

      String heatmapBase64 = '';
      if (annotatedDetections.isNotEmpty) {
        final yoloForHeatmap = YoloDetectionResult(
          detections: annotatedDetections.map((det) => YoloDetection(
            x: det.centerX,
            y: det.centerY,
            width: det.width,
            height: det.height,
            className: det.diagnosis,
            confidence: det.confidence,
            classScores: [det.confidence],
          )).toList(),
          anomalySeverity: isNormal ? 'normal' : 'moderate',
          anomalyScore: fallbackConf,
          primaryAnomaly: fallbackDiag,
          frameWidth: fullImage.width,
          frameHeight: fullImage.height,
          processingTimeMs: 0,
        );
        heatmapBase64 = _generateYoloHeatmap(fullImage, yoloForHeatmap);
      }

      return AnnotatedAnalysisResult(
        annotatedDetections: annotatedDetections,
        overallDiagnosis: fallbackDiag,
        overallConfidence: fallbackConf,
        success: true,
        imageWidth: fullImage.width,
        imageHeight: fullImage.height,
        heatmapBase64: heatmapBase64,
      );
    } catch (e) {
      debugPrint('[MLService] Annotated analysis error: $e');
      return AnnotatedAnalysisResult.error('Analysis failed: $e', 0, 0);
    }
  }

  /// Generate Enhanced ONNX-based Heatmap Visualization
  /// Creates precise, multi-scale activation maps with improved tumor localization
  /// Combines Gaussian blobs with adaptive scaling for accurate representation
  String _generateYoloHeatmap(
      img.Image baseImage, YoloDetectionResult detections) {
    try {
      final w = baseImage.width;
      final h = baseImage.height;

      // ── 1. Build multi-scale float activation map ─────────────────────────────
      // Each detection creates a multi-scale Gaussian with confidence weighting
      final activation = List<Float64List>.generate(h, (_) => Float64List(w));
      final heatmapCount = List<Float64List>.generate(h, (_) => Float64List(w));

      for (final detection in detections.detections) {
        final bounds = detection.getBounds();
        final cx = ((bounds['left']! + bounds['right']!) / 2);
        final cy = ((bounds['top']! + bounds['bottom']!) / 2);
        final bw = (bounds['right']! - bounds['left']!);
        final bh = (bounds['bottom']! - bounds['top']!);
        final conf = detection.confidence.clamp(0.0, 1.0);

        // Use multiple sigma scales for better localization accuracy
        final scales = [0.5, 0.75, 1.0]; // Multi-scale Gaussian
        
        for (final scale in scales) {
          final sigmaX = bw * 0.65 * scale;
          final sigmaY = bh * 0.65 * scale;
          final scaledConf = conf / (scale * 1.5); // Scale confidence by size

          // ±3-sigma region for efficiency
          final x1 = (cx - sigmaX * 3).floor().clamp(0, w - 1);
          final x2 = (cx + sigmaX * 3).ceil().clamp(0, w - 1);
          final y1 = (cy - sigmaY * 3).floor().clamp(0, h - 1);
          final y2 = (cy + sigmaY * 3).ceil().clamp(0, h - 1);

          for (var py = y1; py <= y2; py++) {
            final dy = (py - cy) / sigmaY;
            final dyy = dy * dy;
            for (var px = x1; px <= x2; px++) {
              final dx = (px - cx) / sigmaX;
              final g = scaledConf * exp(-(dx * dx + dyy) / 2.0);
              
              activation[py][px] += g; // Sum overlapping Gaussians
              heatmapCount[py][px] += 1;
            }
          }
        }
      }

      // ── 2. Average overlapping activations and normalize ────────────────────
      double maxAct = 0;
      for (var py = 0; py < h; py++) {
        for (var px = 0; px < w; px++) {
          if (heatmapCount[py][px] > 0) {
            activation[py][px] /= heatmapCount[py][px]; // Average contribution
          }
          if (activation[py][px] > maxAct) {
            maxAct = activation[py][px];
          }
        }
      }

      // Normalize to 0..1 with contrast enhancement
      if (maxAct > 0) {
        for (var py = 0; py < h; py++) {
          for (var px = 0; px < w; px++) {
            var normalized = activation[py][px] / maxAct;
            // Apply sigmoid for better contrast (reduces mid-gray regions)
            normalized = 1.0 / (1.0 + exp(-5.0 * (normalized - 0.5)));
            activation[py][px] = normalized;
          }
        }
      }

      // ── 3. Apply edge enhancement with Sobel operator ──────────────────────
      final edgeMap = List<Float64List>.generate(h, (_) => Float64List(w));
      for (var py = 1; py < h - 1; py++) {
        for (var px = 1; px < w - 1; px++) {
          // Simplified Sobel
          final gx = 
            -activation[py - 1][px - 1] - 2 * activation[py][px - 1] - activation[py + 1][px - 1] +
             activation[py - 1][px + 1] + 2 * activation[py][px + 1] + activation[py + 1][px + 1];
          
          final gy =
            -activation[py - 1][px - 1] - 2 * activation[py - 1][px] - activation[py - 1][px + 1] +
             activation[py + 1][px - 1] + 2 * activation[py + 1][px] + activation[py + 1][px + 1];
          
          edgeMap[py][px] = sqrt(gx * gx + gy * gy).clamp(0.0, 1.0);
        }
      }

      // Combine activation and edge maps for better definition
      for (var py = 0; py < h; py++) {
        for (var px = 0; px < w; px++) {
          activation[py][px] = (activation[py][px] * 0.8 + edgeMap[py][px] * 0.2).clamp(0.0, 1.0);
        }
      }

      // ── 4. Compose enhanced heatmap with jet colormap ──────────────────────
      final heatmap = img.Image.from(baseImage);

      for (var py = 0; py < h; py++) {
        for (var px = 0; px < w; px++) {
          final a = activation[py][px];
          
          // Skip very low activation regions for cleaner display
          if (a < 0.05) continue;
          
          final jet = _jetColor(a);

          // Adaptive blending: higher activation = more colorful
          final blendAlpha = (a * 0.8).clamp(0.0, 0.8);
          final src = baseImage.getPixelSafe(px, py);

          final r = ((1 - blendAlpha) * src.r + blendAlpha * jet[0])
              .round()
              .clamp(0, 255);
          final g = ((1 - blendAlpha) * src.g + blendAlpha * jet[1])
              .round()
              .clamp(0, 255);
          final b = ((1 - blendAlpha) * src.b + blendAlpha * jet[2])
              .round()
              .clamp(0, 255);

          heatmap.setPixelRgba(px, py, r, g, b, 255);
        }
      }

      // ── 5. Enhance tumor regions with sharp boundaries ───────────────────────
      for (final detection in detections.detections) {
        final bounds = detection.getBounds();
        final x1 = bounds['left']!.toInt().clamp(0, w - 1);
        final y1 = bounds['top']!.toInt().clamp(0, h - 1);
        final x2 = bounds['right']!.toInt().clamp(0, w - 1);
        final y2 = bounds['bottom']!.toInt().clamp(0, h - 1);

        // Draw bright border around serious detections (confidence > 0.6)
        if (detection.confidence > 0.6) {
          const borderColor = 255; // Bright white
          const borderThickness = 3;
          
          // Top border
          for (var x = x1; x <= x2; x++) {
            for (var yOff = 0; yOff < borderThickness; yOff++) {
              final y = (y1 + yOff).clamp(0, h - 1);
              heatmap.setPixelRgba(x, y, borderColor, borderColor, 0, 255);
            }
          }
          
          // Bottom border
          for (var x = x1; x <= x2; x++) {
            for (var yOff = 0; yOff < borderThickness; yOff++) {
              final y = (y2 - yOff).clamp(0, h - 1);
              heatmap.setPixelRgba(x, y, borderColor, borderColor, 0, 255);
            }
          }
          
          // Left border
          for (var y = y1; y <= y2; y++) {
            for (var xOff = 0; xOff < borderThickness; xOff++) {
              final x = (x1 + xOff).clamp(0, w - 1);
              heatmap.setPixelRgba(x, y, borderColor, borderColor, 0, 255);
            }
          }
          
          // Right border
          for (var y = y1; y <= y2; y++) {
            for (var xOff = 0; xOff < borderThickness; xOff++) {
              final x = (x2 - xOff).clamp(0, w - 1);
              heatmap.setPixelRgba(x, y, borderColor, borderColor, 0, 255);
            }
          }
        }
      }

      // Encode to PNG with compression
      final heatmapPng = img.encodePng(heatmap);
      return _bytesToBase64(heatmapPng);
    } catch (e) {
      debugPrint('[MLService] Enhanced heatmap generation error: $e');
      return '';
    }
  }

  /// Jet (rainbow) color-map: maps a normalised value [0..1] to [R, G, B].
  ///   0.00 → dark blue
  ///   0.25 → cyan
  ///   0.50 → green / yellow
  ///   0.75 → orange
  ///   1.00 → dark red
  List<int> _jetColor(double t) {
    t = t.clamp(0.0, 1.0);
    int r, g, b;
    if (t < 0.125) {
      r = 0;
      g = 0;
      b = (128 + t / 0.125 * 127).round();
    } else if (t < 0.375) {
      r = 0;
      g = ((t - 0.125) / 0.25 * 255).round();
      b = 255;
    } else if (t < 0.625) {
      r = ((t - 0.375) / 0.25 * 255).round();
      g = 255;
      b = (255 - (t - 0.375) / 0.25 * 255).round();
    } else if (t < 0.875) {
      r = 255;
      g = (255 - (t - 0.625) / 0.25 * 255).round();
      b = 0;
    } else {
      r = (255 - (t - 0.875) / 0.125 * 127).round();
      g = 0;
      b = 0;
    }
    return [r.clamp(0, 255), g.clamp(0, 255), b.clamp(0, 255)];
  }

  /// Convert bytes to base64 string
  String _bytesToBase64(List<int> bytes) {
    return base64Encode(bytes);
  }

  /// 3D CT Lung Cancer CAD Analysis
  /// Complete pipeline: DICOM preprocessing → Nodule detection → Classification
  /// Returns detected nodules with malignancy risk assessment
  Future<CAD3DAnalysisResult> analyze3DCtScan(
    Directory dicomFolder, {
    int targetDepth = 64,
    int targetRows = 64,
    int targetCols = 64,
  }) async {
    try {
      debugPrint('[MLService] Starting 3D CT CAD analysis...');

      final result = await _cad3dService.analyzeCtScan(
        dicomFolder,
        targetDepth: targetDepth,
        targetRows: targetRows,
        targetCols: targetCols,
      );

      return result;
    } catch (e) {
      debugPrint('[MLService] 3D analysis error: $e');
      return CAD3DAnalysisResult.error('3D analysis failed: $e');
    }
  }

  /// Preprocess DICOM folder to 3D volume
  Future<PreprocessedCTVolume?> preprocessDicomFolder(
    Directory dicomFolder, {
    int targetDepth = 64,
    int targetRows = 64,
    int targetCols = 64,
  }) async {
    try {
      final dicomService = DicomPreprocessingService();
      return await dicomService.preprocessDicomFolder(
        dicomFolder,
        targetDepth: targetDepth,
        targetRows: targetRows,
        targetCols: targetCols,
      );
    } catch (e) {
      debugPrint('[MLService] DICOM preprocessing error: $e');
      return null;
    }
  }

  /// Access 3D CAD services for advanced analysis
  CAD3DAnalysisService get cad3dService => _cad3dService;
  
  /// Access 3D detection service
  Nodule3DDetectionService get detector3d => _cad3dService.detectorService;
  
  /// Access 3D classifier service
  Nodule3DClassifierService get classifier3d => _cad3dService.classifierService;

  /// Clean up resources
  void dispose() {
    try {
      _onnxService.dispose();
      _yoloService.dispose();
      _denseNetService.dispose();
      _doctrService.dispose();
      _cad3dService.dispose();
      debugPrint('[MLService] All ML services disposed');
    } catch (e) {
      debugPrint('[MLService] Error during disposal: $e');
    }
  }
}

enum AnalysisStatus { complete, error }

class MLResponse {
  final String diagnosis;
  final double confidence;
  final Map<String, double> classScores;
  final String? heatmapUrl;
  final AnalysisStatus status;
  final String? errorMessage;

  const MLResponse({
    required this.diagnosis,
    required this.confidence,
    required this.classScores,
    this.heatmapUrl,
    required this.status,
    this.errorMessage,
  });

  factory MLResponse.error(String msg) => MLResponse(
        diagnosis: '',
        confidence: 0,
        classScores: {},
        status: AnalysisStatus.error,
        errorMessage: msg,
      );

  bool get isSuccess => status == AnalysisStatus.complete;
}

/// Combined result from YOLO detection + Doctr OCR + optional backend analysis
class CombinedAnalysisResult {
  final YoloDetectionResult yoloDetection;
  final DocumentText? documentOCR;
  final MLResponse? backendAnalysis;
  final DateTime timestamp;
  final String? errorMessage;

  const CombinedAnalysisResult({
    required this.yoloDetection,
    this.documentOCR,
    this.backendAnalysis,
    required this.timestamp,
    this.errorMessage,
  });

  /// Get combined severity assessment
  String getCombinedSeverity() {
    if (errorMessage != null) return 'error';

    // Combine YOLO severity with document findings
    var yoloSeverity = yoloDetection.anomalySeverity;
    
    if (documentOCR != null && _containsCriticalKeywords(documentOCR!)) {
      if (yoloSeverity != 'critical') {
        yoloSeverity = 'moderate';
      }
    }

    return yoloSeverity;
  }

  /// Check if document contains critical findings
  bool _containsCriticalKeywords(DocumentText doc) {
    const criticalTerms = [
      'pneumonia',
      'tuberculosis',
      'fracture',
      'nodule',
      'critical',
      'severe',
    ];

    final text = doc.fullText.toLowerCase();
    return criticalTerms.any((term) => text.contains(term));
  }

  /// Generate comprehensive report
  String generateReport() {
    final buffer = StringBuffer();

    buffer.writeln('=== CHEST X-RAY ANALYSIS REPORT ===\n');
    buffer.writeln('Timestamp: $timestamp\n');

    // YOLO Detection Report
    buffer.writeln('YOLO DETECTION ANALYSIS:');
    buffer.writeln('Severity: ${yoloDetection.anomalySeverity}');
    buffer.writeln('Anomaly Score: ${(yoloDetection.anomalyScore * 100).toStringAsFixed(1)}%');
    buffer.writeln('Primary Finding: ${yoloDetection.primaryAnomaly}');
    buffer.writeln('Detections Found: ${yoloDetection.detections.length}');
    
    if (yoloDetection.detections.isNotEmpty) {
      buffer.writeln('\nDetailed Detections:');
      for (final detection in yoloDetection.getSortedByConfidence()) {
        buffer.writeln(
          '  - ${detection.className}: ${(detection.confidence * 100).toStringAsFixed(1)}%',
        );
      }
    }

    // OCR Report
    if (documentOCR != null) {
      buffer.writeln('\n\nDOCUMENT OCR ANALYSIS:');
      buffer.writeln('Characters Recognized: ${documentOCR!.charactersCount}');
      buffer.writeln('OCR Confidence: ${(documentOCR!.confidence * 100).toStringAsFixed(1)}%');
      
      if (documentOCR!.keywordsDetected.isNotEmpty) {
        buffer.writeln('Medical Keywords Found:');
        for (final keyword in documentOCR!.keywordsDetected) {
          buffer.writeln('  - $keyword');
        }
      }
    }

    // Backend Analysis
    if (backendAnalysis != null && backendAnalysis!.isSuccess) {
      buffer.writeln('\n\nBACKEND ANALYSIS:');
      buffer.writeln('Diagnosis: ${backendAnalysis!.diagnosis}');
      buffer.writeln('Confidence: ${(backendAnalysis!.confidence * 100).toStringAsFixed(1)}%');
    }

    buffer.writeln('\n\nCOMBINED ASSESSMENT:');
    buffer.writeln('Overall Severity: ${getCombinedSeverity()}');
    buffer.writeln(yoloDetection.getSeverityDescription());

    return buffer.toString();
  }

  /// Serialize to map for Firebase storage
  Map<String, dynamic> toMap() {
    return {
      'timestamp': timestamp.toIso8601String(),
      'yoloDetection': yoloDetection.toMap(),
      'documentOCR': documentOCR?.toMap(),
      'backendAnalysis': backendAnalysis != null
          ? {
              'diagnosis': backendAnalysis!.diagnosis,
              'confidence': backendAnalysis!.confidence,
              'classScores': backendAnalysis!.classScores,
            }
          : null,
      'combinedSeverity': getCombinedSeverity(),
    };
  }

  /// Error result
  factory CombinedAnalysisResult.error(String message) => CombinedAnalysisResult(
        yoloDetection: YoloDetectionResult.error(message),
        documentOCR: null,
        backendAnalysis: null,
        timestamp: DateTime.now(),
        errorMessage: message,
      );

  bool get isSuccess => errorMessage == null && yoloDetection.isSuccess;
}

/// COMPREHENSIVE ANALYSIS RESULT
/// Combines YOLO lung detection + DenseNet disease classification
class ComprehensiveAnalysisResult {
  final YoloDetectionResult yoloDetection; // Lung cancer detection
  final ClassificationResult denseNetClassification; // Chest disease classification
  final DocumentText? documentOCR;
  final MLResponse? backendAnalysis;
  final DateTime timestamp;
  final int totalProcessingTimeMs;
  final String? errorMessage;

  const ComprehensiveAnalysisResult({
    required this.yoloDetection,
    required this.denseNetClassification,
    this.documentOCR,
    this.backendAnalysis,
    required this.timestamp,
    required this.totalProcessingTimeMs,
    this.errorMessage,
  });

  bool get isSuccess => errorMessage == null;

  /// Get overall severity combining both models
  String getOverallSeverity() {
    if (errorMessage != null) return 'error';

    final yoloSeverity = yoloDetection.anomalySeverity;
    final classificationSeverity = denseNetClassification.primaryClassification.severity;

    // If either is critical, overall is critical
    if (yoloSeverity == 'critical' || classificationSeverity == 'critical') {
      return 'critical';
    }

    // If either is severe, overall is severe
    if (yoloSeverity == 'severe' || classificationSeverity == 'severe') {
      return 'severe';
    }

    // If either is moderate, overall is moderate
    if (yoloSeverity == 'moderate' || classificationSeverity == 'moderate') {
      return 'moderate';
    }

    return 'mild';
  }

  /// Get overall confidence (average of both models)
  double getOverallConfidence() {
    final yoloConf = yoloDetection.anomalyScore;
    final classConf = denseNetClassification.primaryClassification.confidence;
    return (yoloConf + classConf) / 2;
  }

  /// Generate comprehensive medical report
  String generateComprehensiveReport() {
    final buffer = StringBuffer();

    buffer.writeln('╔════════════════════════════════════════════════════════╗');
    buffer.writeln('║     COMPREHENSIVE CHEST X-RAY ANALYSIS REPORT          ║');
    buffer.writeln('╚════════════════════════════════════════════════════════╝\n');

    buffer.writeln('📋 ANALYSIS METADATA:');
    buffer.writeln('Timestamp: ${timestamp.toString()}');
    buffer.writeln('Total Processing Time: ${totalProcessingTimeMs}ms');
    buffer.writeln('Overall Severity: ${getOverallSeverity().toUpperCase()}');
    buffer.writeln('Overall Confidence: ${(getOverallConfidence() * 100).toStringAsFixed(1)}%\n');

    // YOLO Detection Section
    buffer.writeln('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
    buffer.writeln('🫁 LUNG CANCER DETECTION (YOLO MODEL):');
    buffer.writeln('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
    buffer.writeln('Status: ${yoloDetection.isSuccess ? 'SUCCESS' : 'FAILED'}');

    if (yoloDetection.isSuccess) {
      buffer.writeln('Severity Level: ${yoloDetection.anomalySeverity.toUpperCase()}');
      buffer.writeln(yoloDetection.getSeverityDescription());
      buffer.writeln('Anomaly Score: ${(yoloDetection.anomalyScore * 100).toStringAsFixed(1)}%');
      buffer.writeln('Primary Finding: ${yoloDetection.primaryAnomaly}');
      buffer.writeln('Detections Found: ${yoloDetection.detections.length}');

      if (yoloDetection.detections.isNotEmpty) {
        buffer.writeln('\nDetailed Detections:');
        for (final detection in yoloDetection.getSortedByConfidence()) {
          final confPercent =
              (detection.confidence * 100).toStringAsFixed(1);
          buffer.writeln('  ├─ ${detection.className}: $confPercent%');
        }
      }
      buffer.writeln('Processing Time: ${yoloDetection.processingTimeMs}ms\n');
    } else {
      buffer.writeln('Error: ${yoloDetection.errorMessage}\n');
    }

    // DenseNet Classification Section
    buffer.writeln('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
    buffer.writeln('🏥 CHEST DISEASE CLASSIFICATION (DENSENET MODEL):');
    buffer.writeln('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
    buffer.writeln('Status: ${denseNetClassification.isSuccess ? 'SUCCESS' : 'FAILED'}');

    if (denseNetClassification.isSuccess) {
      final primary = denseNetClassification.primaryClassification;
      buffer.writeln('Primary Diagnosis: ${primary.disease}');
      buffer.writeln(primary.getDescription());
      buffer.writeln('Severity Level: ${primary.severity.toUpperCase()}');
      buffer.writeln('Model Version: ${denseNetClassification.modelVersion}');

      buffer.writeln('\nAll Classifications:');
      for (final classification in denseNetClassification.getSortedByConfidence()) {
        final confPercent =
            (classification.confidence * 100).toStringAsFixed(1);
        buffer.writeln('  ├─ ${classification.disease}: $confPercent%');
      }
      buffer.writeln('Processing Time: ${denseNetClassification.processingTimeMs}ms\n');
    } else {
      buffer.writeln('Error: ${denseNetClassification.errorMessage}\n');
    }

    // Document OCR Section (if available)
    if (documentOCR != null) {
      buffer.writeln('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
      buffer.writeln('📄 DOCUMENT OCR ANALYSIS:');
      buffer.writeln('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
      buffer.writeln('Characters Recognized: ${documentOCR!.charactersCount}');
      buffer.writeln('OCR Confidence: ${(documentOCR!.confidence * 100).toStringAsFixed(1)}%');

      if (documentOCR!.keywordsDetected.isNotEmpty) {
        buffer.writeln('Medical Keywords Found:');
        for (final keyword in documentOCR!.keywordsDetected) {
          buffer.writeln('  ├─ $keyword');
        }
      }
      buffer.writeln();
    }

    // Final Recommendation
    buffer.writeln('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
    buffer.writeln('💡 FINAL RECOMMENDATION:');
    buffer.writeln('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
    buffer.writeln(_generateRecommendation());

    return buffer.toString();
  }

  /// Generate recommendation based on analysis
  String _generateRecommendation() {
    final severity = getOverallSeverity();
    final yoloPrimary = yoloDetection.primaryAnomaly;
    final densenetDisease = denseNetClassification.primaryClassification.disease;

    switch (severity) {
      case 'critical':
        return '🚨 CRITICAL - Immediate medical attention required.\n'
            'Patient should be referred to specialist immediately.\n'
            'Suspected findings: $yoloPrimary + $densenetDisease';

      case 'severe':
        return '⚠️ SEVERE - Urgent follow-up consultation recommended.\n'
            'Additional diagnostic tests may be necessary.\n'
            'Suspected findings: $yoloPrimary + $densenetDisease';

      case 'moderate':
        return '⚠️ MODERATE - Follow-up appointment recommended within 1-2 weeks.\n'
            'Monitor symptoms closely.\n'
            'Suspected findings: $yoloPrimary + $densenetDisease';

      case 'mild':
        return '✓ MILD - Continue regular monitoring.\n'
            'Follow-up review recommended within 1 month.\n'
            'Suspected findings: $yoloPrimary + $densenetDisease';

      default:
        return '? INCONCLUSIVE - Unable to determine severity.\n'
            'Manual review by specialist recommended.';
    }
  }

  /// Serialize to map for Firebase storage
  Map<String, dynamic> toMap() {
    return {
      'timestamp': timestamp.toIso8601String(),
      'totalProcessingTimeMs': totalProcessingTimeMs,
      'yoloDetection': yoloDetection.toMap(),
      'denseNetClassification': denseNetClassification.toMap(),
      'documentOCR': documentOCR?.toMap(),
      'backendAnalysis': backendAnalysis != null
          ? {
              'diagnosis': backendAnalysis!.diagnosis,
              'confidence': backendAnalysis!.confidence,
              'classScores': backendAnalysis!.classScores,
            }
          : null,
      'overallSeverity': getOverallSeverity(),
      'overallConfidence': getOverallConfidence(),
    };
  }

  /// Error result
  factory ComprehensiveAnalysisResult.error(String message) => ComprehensiveAnalysisResult(
        yoloDetection: YoloDetectionResult.error(message),
        denseNetClassification: ClassificationResult.error(message),
        documentOCR: null,
        backendAnalysis: null,
        timestamp: DateTime.now(),
        totalProcessingTimeMs: 0,
        errorMessage: message,
      );
}

/// Represents a single annotated detection with diagnosis
/// Used for visual overlay on doctor's X-ray screen
class AnnotatedDetection {
  final double x1; // Top-left X
  final double y1; // Top-left Y
  final double x2; // Bottom-right X
  final double y2; // Bottom-right Y
  final String diagnosis; // DenseNet classification (e.g., "Adenocarcinoma")
  final double confidence; // DenseNet confidence
  final double yoloConfidence; // YOLO detection confidence

  AnnotatedDetection({
    required this.x1,
    required this.y1,
    required this.x2,
    required this.y2,
    required this.diagnosis,
    required this.confidence,
    required this.yoloConfidence,
  });

  /// Get box width
  double get width => x2 - x1;

  /// Get box height
  double get height => y2 - y1;

  /// Get box center X
  double get centerX => (x1 + x2) / 2;

  /// Get box center Y
  double get centerY => (y1 + y2) / 2;

  /// Get confidence as percentage string
  String get confidencePercent => '${(confidence * 100).toStringAsFixed(1)}%';

  /// Get short diagnosis name (e.g., "Adenocarcinoma" → "Adenocarc.")
  String get shortDiagnosis {
    final parts = diagnosis.split(' ');
    return parts.isNotEmpty ? parts[0].substring(0, 8) : diagnosis;
  }
}

/// Result with annotated detections for visual display on doctor screen
class AnnotatedAnalysisResult {
  final List<AnnotatedDetection> annotatedDetections;
  final String overallDiagnosis;
  final double overallConfidence;
  final bool success;
  final String? errorMessage;
  final int imageWidth;
  final int imageHeight;
  final String heatmapBase64; // Base64-encoded heatmap PNG

  AnnotatedAnalysisResult({
    required this.annotatedDetections,
    required this.overallDiagnosis,
    required this.overallConfidence,
    required this.success,
    this.errorMessage,
    required this.imageWidth,
    required this.imageHeight,
    this.heatmapBase64 = '',
  });

  factory AnnotatedAnalysisResult.error(String message, int width, int height) =>
      AnnotatedAnalysisResult(
        annotatedDetections: [],
        overallDiagnosis: 'Analysis Failed',
        overallConfidence: 0,
        success: false,
        errorMessage: message,
        imageWidth: width,
        imageHeight: height,
        heatmapBase64: '',
      );

  factory AnnotatedAnalysisResult.noDetections(
    int width,
    int height,
    String diagnosis,
    double confidence,
  ) =>
      AnnotatedAnalysisResult(
        annotatedDetections: [],
        overallDiagnosis: diagnosis,
        overallConfidence: confidence,
        success: true,
        imageWidth: width,
        imageHeight: height,
        heatmapBase64: '',
      );
}
